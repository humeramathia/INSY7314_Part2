PORT=3000
JWT_SECRET=replace_with_your_own_secure_random_secret
JWT_EXPIRES_IN=1h
MONGODB_URI=mongodb://127.0.0.1:27017/hustlehub
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
ADMIN_NAME=HustleHub Admin
ADMIN_EMAIL=admin@hustlehub.local
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Logging: error | warn | info | debug
LOG_LEVEL=info
# Folder for app.log, security.log and error.log (defaults to ./logs)
LOG_DIR=./logs
# Set to true when running behind Docker/nginx so the real client IP is logged
TRUST_PROXY=false

# Grafana Loki (Compose sets this to http://loki:3100/loki/api/v1/push).
# For Grafana Cloud, use your Loki push URL and instance credentials. Leave blank locally.
# LOKI_URL=https://logs-prod-xxx.grafana.net/loki/api/v1/push
# LOKI_USERNAME=
# LOKI_PASSWORD=
# Optional: override the local Grafana admin password (default admin)
# GRAFANA_ADMIN_PASSWORD=admin
