{
  "info": {
    "name": "HustleHub+ CI",
    "description": "Integration tests for GitHub Actions. Auth hits stay within the 5-per-15-minute limiter.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:3000" },
    { "key": "freelancerEmail", "value": "" },
    { "key": "clientEmail", "value": "" },
    { "key": "token", "value": "" },
    { "key": "clientToken", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('freelancerEmail')) {",
          "  const stamp = Date.now();",
          "  pm.collectionVariables.set('freelancerEmail', 'ci-free-' + stamp + '@test.com');",
          "  pm.collectionVariables.set('clientEmail', 'ci-client-' + stamp + '@test.com');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('health returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('success envelope', () => {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.message).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Register freelancer",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('register returns 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('does not return a password', () => {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data).to.be.an('object');",
              "  pm.expect(body.data.password).to.be.undefined;",
              "  pm.expect(body.data.role).to.eql('freelancer');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"CI Freelancer\",\n  \"email\": \"{{freelancerEmail}}\",\n  \"password\": \"Secret123!\",\n  \"role\": \"freelancer\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Login freelancer",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('returns a JWT', () => {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data.token).to.be.a('string').and.not.empty;",
              "});",
              "if (body.data && body.data.token) {",
              "  pm.collectionVariables.set('token', body.data.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{freelancerEmail}}\",\n  \"password\": \"Secret123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Current user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('me returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('identifies the freelancer', () => {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data.role).to.eql('freelancer');",
              "  pm.expect(body.data.password).to.be.undefined;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "Create gig",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('create gig returns 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('gig payload', () => {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data.title).to.eql('CI window cleaning');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"CI window cleaning\",\n  \"description\": \"Clean windows for the CI run.\",\n  \"category\": \"Cleaning\",\n  \"price\": 250\n}"
        },
        "url": "{{baseUrl}}/api/gigs"
      }
    },
    {
      "name": "List gigs",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('list gigs returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('returns an array', () => {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/gigs"
      }
    },
    {
      "name": "Register weak password",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('weak password returns 400', () => pm.response.to.have.status(400));",
              "const body = pm.response.json();",
              "pm.test('failure envelope', () => {",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.message).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Weak User\",\n  \"email\": \"weak@test.com\",\n  \"password\": \"secret123\",\n  \"role\": \"client\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Me without token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('missing token returns 401', () => pm.response.to.have.status(401));",
              "pm.test('failure envelope', () => pm.expect(pm.response.json().success).to.eql(false));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "Register client",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('client register returns 201', () => pm.response.to.have.status(201));",
              "pm.test('success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"CI Client\",\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"Secret123!\",\n  \"role\": \"client\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Login client",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('client login returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('returns a JWT', () => pm.expect(body.data.token).to.be.a('string').and.not.empty);",
              "if (body.data && body.data.token) {",
              "  pm.collectionVariables.set('clientToken', body.data.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"Secret123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Client cannot create gig",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('client create gig returns 403', () => pm.response.to.have.status(403));",
              "pm.test('failure envelope', () => pm.expect(pm.response.json().success).to.eql(false));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{clientToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Should not work\",\n  \"description\": \"Clients must not list gigs.\",\n  \"category\": \"Cleaning\",\n  \"price\": 100\n}"
        },
        "url": "{{baseUrl}}/api/gigs"
      }
    },
    {
      "name": "Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('logout returns 200', () => pm.response.to.have.status(200));",
              "pm.test('success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
        "url": "{{baseUrl}}/api/auth/logout"
      }
    },
    {
      "name": "Me after logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('revoked token returns 401', () => pm.response.to.have.status(401));",
              "pm.test('failure envelope', () => pm.expect(pm.response.json().success).to.eql(false));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    }
  ]
}
