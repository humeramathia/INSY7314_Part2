{
  "name": "hustlehub-plus",
  "version": "1.0.0",
  "description": "HustleHub+ secure freelance marketplace API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "certs": "node scripts/generate-certs.js",
    "create-admin": "node scripts/create-admin.js",
    "build": "node --check src/server.js src/app.js",
    "build:client": "npm run build --prefix client",
    "test": "npm run test:backend && npm run test:tax && npm run test:logger && npm run test:client",
    "test:backend": "node --test src/utils/password.test.js src/utils/jwt.test.js src/utils/response.test.js",
    "test:tax": "node --test src/utils/taxEstimate.test.js",
    "test:logger": "node --test src/utils/logger.test.js",
    "test:client": "npm test --prefix client",
    "test:ci": "newman run postman/HustleHub-CI.postman_collection.json --insecure --env-var baseUrl=https://localhost:3000",
    "test:api": "newman run postman/HustleHub-Part2.postman_collection.json --insecure --environment postman/local-secrets.json",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1"
  },
  "devDependencies": {
    "newman": "^6.2.3"
  }
}
